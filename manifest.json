{
  "manifest_version": 3,
  "name": "Property Details for Rightmove",
  "version": "1.3.2",
  "description": "Show available property size, council tax band, ground rent, service charge and lease remaining on search cards.",
  "permissions": ["offscreen", "storage"],
  "action": {"default_title": "Rightmove Property Details", "default_popup": "popup.html"},
  "host_permissions": ["https://www.rightmove.co.uk/*", "https://media.rightmove.co.uk/*"],
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://www.rightmove.co.uk/property-for-sale/*", "https://www.rightmove.co.uk/property-to-rent/*"],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }]
}
